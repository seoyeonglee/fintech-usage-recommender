{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["src/domain/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
